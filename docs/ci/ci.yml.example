# INACTIVE TEMPLATE: this file is deliberately outside .github/workflows.
# Do not activate until the owner confirms free capacity or an explicit budget.
# Reviewed action tag refs were resolved through the GitHub API during implementation.
name: Candidate checks (inactive template)
on:
  pull_request:
  push:
    branches: [work]
permissions:
  contents: read
concurrency:
  group: candidate-${{ github.ref }}
  cancel-in-progress: true
jobs:
  verify:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: 24.19.0
      - run: npm ci --no-audit --no-fund
      - run: ./node_modules/.bin/playwright install chromium
      - run: npm run check
        env:
          NEXT_TELEMETRY_DISABLED: '1'
          SITE_RELEASE_APPROVED: 'false'
          SITE_PUBLIC_ORIGIN: ''
# No secrets, artifact publication, deployment or package publication permissions.
