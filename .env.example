# Public build configuration, never secrets.
# These names are part of the implementation contract; the app does not exist yet.
# Default builds must stay non-indexable.
SITE_RELEASE_APPROVED=false
SITE_PUBLIC_ORIGIN=

# BOTH an explicit approved HTTPS origin and SITE_RELEASE_APPROVED=true are
# required for public canonical URLs and a public sitemap. A flag does not grant
# permission to deploy or approve release on the owner's behalf.

# Disable framework telemetry in the build environment.
NEXT_TELEMETRY_DISABLED=1
